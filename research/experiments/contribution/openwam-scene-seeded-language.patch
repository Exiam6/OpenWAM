diff --git a/tests/test_robotwin_scene_seeded_language.py b/tests/test_robotwin_scene_seeded_language.py
new file mode 100644
index 0000000..8e125bc
--- /dev/null
+++ b/tests/test_robotwin_scene_seeded_language.py
@@ -0,0 +1,84 @@
+"""Paired language sampling must not change environment RNG or swallow errors."""
+
+import random
+from types import SimpleNamespace
+
+import pytest
+
+from benchmarks.robotwin.eval_policy_wrapper import _install_scene_seeded_language
+
+
+class Env:
+    def setup_demo(self, *, seed, **kwargs):
+        self.seed = seed
+        return kwargs
+
+
+def make_module(generator):
+    return SimpleNamespace(class_decorator=lambda name: Env(), generate_episode_descriptions=generator)
+
+
+def test_same_scene_produces_same_language_with_unrelated_outer_rng():
+    def generate(task, *, count):
+        words = list(range(100))
+        random.shuffle(words)
+        return task, random.sample(words, count)
+
+    module = make_module(generate)
+    _install_scene_seeded_language(module)
+    env = module.class_decorator("task")
+    results = []
+    for outer in (9, 27, 80):
+        random.seed(outer)
+        assert env.setup_demo(seed=200001, is_test=True) == {"is_test": True}
+        prior = random.getstate()
+        results.append(module.generate_episode_descriptions("pick", count=12))
+        assert random.getstate() == prior
+    assert results[0] == results[1] == results[2]
+    env.setup_demo(seed=200002)
+    assert module.generate_episode_descriptions("pick", count=12) != results[0]
+
+
+def test_generation_failure_restores_rng_and_propagates_error():
+    def generate():
+        random.random()
+        raise ValueError("missing description")
+
+    module = make_module(generate)
+    _install_scene_seeded_language(module)
+    env = module.class_decorator("task")
+    env.setup_demo(seed=100000)
+    prior = random.getstate()
+    with pytest.raises(ValueError, match="missing description"):
+        module.generate_episode_descriptions()
+    assert random.getstate() == prior
+
+
+def test_missing_seed_fails_before_sampling():
+    module = make_module(lambda: pytest.fail("must not sample without scene seed"))
+    _install_scene_seeded_language(module)
+    with pytest.raises(RuntimeError, match="setup_demo"):
+        module.generate_episode_descriptions()
+
+
+@pytest.mark.parametrize("flag,expected", [(None, False), ("0", False), ("1", True)])
+def test_bootstrap_only_enables_language_scoping_when_requested(monkeypatch, tmp_path, flag, expected):
+    from benchmarks.robotwin import eval_policy_wrapper as wrapper
+
+    module = object()
+    called = []
+    monkeypatch.setenv("ROBOTWIN_PATH", str(tmp_path))
+    monkeypatch.delenv("ROBOTWIN_ENABLE_PLANNER_FALLBACK", raising=False)
+    if flag is None:
+        monkeypatch.delenv("ROBOTWIN_SCENE_SEEDED_LANGUAGE", raising=False)
+    else:
+        monkeypatch.setenv("ROBOTWIN_SCENE_SEEDED_LANGUAGE", flag)
+    monkeypatch.setattr(wrapper, "_warn_on_unverified_robotwin", lambda path: None)
+    monkeypatch.setattr(wrapper, "_prepare_runtime_root", lambda path: path)
+    monkeypatch.setattr(wrapper, "_prewarm_cuda_for_curobo", lambda: None)
+    monkeypatch.setattr(wrapper, "_patch_warp_torch_namespace", lambda: None)
+    monkeypatch.setattr(wrapper, "_load_robotwin_eval_module", lambda path: module)
+    monkeypatch.setattr(wrapper, "_install_scene_seeded_language", called.append)
+    monkeypatch.chdir(tmp_path)
+    assert wrapper.bootstrap_robotwin_module(install_trace_hooks=False) is module
+    assert called == ([module] if expected else [])
