+"""Opt-in JSONL tracing and comparison at the policy transport boundary."""
+
+import argparse
+import base64
+import hashlib
+import json
+from pathlib import Path
+
+_FIELDS = (
+    "event",
+    "method",
+    "request_sha256",
+    "image_payload_sha256",
+    "prompt_sha256",
+    "state_sha256",
+    "action_sha256",
+    "server_step",
+    "error_type",
+)
+
+
+def _json(value):
+    return json.dumps(value, sort_keys=True, separators=(",", ":"), allow_nan=False)
+
+
+def _hash(value):
+    return hashlib.sha256(_json(value).encode()).hexdigest()
+
+
+class TracedPolicyClient:
+    """Wrap an existing client without changing calls, arguments or responses.
+
+    The new path must not exist. Closing this wrapper also closes its client.
+    Trace failures propagate; silently incomplete diagnostic logs are not accepted.
+    """
+
+    def __init__(self, client, path, *, metadata=None):
+        header = _json({"schema": "openwam-policy-trace-v1", "metadata": metadata or {}})
+        self.client = client
+        self._file = Path(path).open("x", encoding="utf-8")
+        self._file.write(header + "\n")
+        self._file.flush()
+        self._index = 0
+
+    def _write(self, record):
+        self._file.write(_json({"index": self._index, **record}) + "\n")
+        self._file.flush()
+        self._index += 1
+
+    def _call(self, method, payload=None):
+        if self._file.closed:
+            raise ValueError("trace is closed")
+        record = {"method": method}
+        if payload is not None:
+            record.update(
+                request_sha256=_hash(payload),
+                image_payload_sha256={
+                    key: hashlib.sha256(base64.b64decode(value, validate=True)).hexdigest()
+                    if value is not None
+                    else None
+                    for key, value in payload.get("images", {}).items()
+                },
+                prompt_sha256=_hash(payload.get("prompt")),
+                state_sha256=_hash(payload.get("state")),
+                state=json.loads(_json(payload.get("state"))),
+            )
+        try:
+            response = getattr(self.client, method)(payload) if payload is not None else getattr(self.client, method)()
+        except Exception as error:
+            self._write({**record, "event": "error", "error_type": type(error).__name__})
+            raise
+        record.update(event="prediction" if payload is not None else "reset", server_step=response.get("step"))
+        if payload is not None:
+            record.update(action=response["action"], action_sha256=_hash(response["action"]))
+        self._write(record)
+        return response
+
+    def predict(self, payload):
+        return self._call("predict", payload)
+
+    def predict_once(self, payload):
+        return self._call("predict_once", payload)
+
+    def reset(self):
+        return self._call("reset")
+
+    def ping(self):
+        return self.client.ping()
+
+    def close(self):
+        try:
+            self.client.close()
+        finally:
+            self._file.close()
+
+    def __enter__(self):
+        return self
+
+    def __exit__(self, *exc):
+        self.close()
+
+
+def _read(path):
+    rows = [json.loads(line) for line in Path(path).read_text(encoding="utf-8").splitlines()]
+    if not rows or rows[0].get("schema") != "openwam-policy-trace-v1":
+        raise ValueError("unsupported or missing trace header")
+    header, events = rows[0], rows[1:]
+    for index, row in enumerate(events):
+        if row.get("index") != index or row.get("event") not in {"prediction", "reset", "error"}:
+            raise ValueError(f"invalid trace event {index}")
+        if row["event"] == "prediction":
+            if _hash(row["action"]) != row["action_sha256"] or _hash(row["state"]) != row["state_sha256"]:
+                raise ValueError(f"trace value/hash mismatch at event {index}")
+    return header, events
+
+
+def compare_traces(left, right):
+    """Compare aligned event prefixes; include length and metadata mismatches."""
+    a_header, a = _read(left)
+    b_header, b = _read(right)
+    first = {
+        field: next(
+            (i for i, (x, y) in enumerate(zip(a, b)) if (field in x, x.get(field)) != (field in y, y.get(field))), None
+        )
+        for field in _FIELDS
+    }
+    return {
+        "event_counts": [len(a), len(b)],
+        "metadata_equal": a_header.get("metadata") == b_header.get("metadata"),
+        "first_different_event": first,
+        "same_recorded_trace": len(a) == len(b)
+        and a_header == b_header
+        and all(value is None for value in first.values()),
+    }
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("left")
+    parser.add_argument("right")
+    args = parser.parse_args()
+    print(json.dumps(compare_traces(args.left, args.right), indent=2))
+
+
+if __name__ == "__main__":
+    main()
