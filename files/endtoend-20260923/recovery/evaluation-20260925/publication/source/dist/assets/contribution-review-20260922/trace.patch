+"""Trace contracts: no transport changes, honest mismatches, native eval parity."""
+
+import base64
+import copy
+import json
+import random
+import tempfile
+import unittest
+from pathlib import Path
+
+import numpy as np
+
+from benchmarks.utils.policy_trace import TracedPolicyClient, compare_traces
+
+
+class Client:
+    def __init__(self):
+        self.response = {"action": [0.0, 1.0], "step": 1, "latency_ms": 12}
+        self.calls = []
+        self.closed = False
+
+    def predict(self, payload):
+        self.calls.append(("predict", payload))
+        return self.response
+
+    def predict_once(self, payload):
+        self.calls.append(("predict_once", payload))
+        return self.response
+
+    def reset(self):
+        self.calls.append(("reset", None))
+        return {"type": "reset_ack"}
+
+    def ping(self):
+        return {"type": "pong"}
+
+    def close(self):
+        self.closed = True
+
+
+class PolicyTraceTests(unittest.TestCase):
+    def setUp(self):
+        self.directory = tempfile.TemporaryDirectory()
+        self.addCleanup(self.directory.cleanup)
+        self.path = Path(self.directory.name)
+        self.payload = {
+            "images": {"head_camera": base64.b64encode(b"encoded-image").decode()},
+            "prompt": "pick",
+            "state": [0.1],
+        }
+
+    def write_trace(self, name, payload=None, action=None):
+        client = Client()
+        if action is not None:
+            client.response["action"] = action
+        with TracedPolicyClient(client, self.path / name, metadata={"scene": 1}) as traced:
+            traced.predict(payload or self.payload)
+        return self.path / name
+
+    def test_passthrough_identity_retry_choice_rng_and_close(self):
+        client = Client()
+        before = copy.deepcopy(self.payload)
+        np_before, py_before = np.random.get_state(), random.getstate()
+        with TracedPolicyClient(client, self.path / "trace") as traced:
+            self.assertIs(traced.predict(self.payload), client.response)
+            self.assertIs(traced.predict_once(self.payload), client.response)
+            self.assertEqual(traced.reset(), {"type": "reset_ack"})
+            self.assertEqual(traced.ping(), {"type": "pong"})
+        self.assertTrue(client.closed)
+        self.assertEqual([c[0] for c in client.calls], ["predict", "predict_once", "reset"])
+        self.assertIs(client.calls[0][1], self.payload)
+        self.assertEqual(self.payload, before)
+        self.assertTrue(all(np.array_equal(x, y) for x, y in zip(np_before, np.random.get_state())))
+        self.assertEqual(py_before, random.getstate())
+        with self.assertRaises(ValueError):
+            traced.predict(self.payload)
+        self.assertEqual(len(client.calls), 3)
+
+    def test_error_is_recorded_and_same_exception_propagates(self):
+        client = Client()
+        error = RuntimeError("server failed")
+
+        def fail(payload):
+            raise error
+
+        client.predict = fail
+        with TracedPolicyClient(client, self.path / "trace") as traced:
+            with self.assertRaises(RuntimeError) as caught:
+                traced.predict(self.payload)
+            self.assertIs(caught.exception, error)
+        row = json.loads((self.path / "trace").read_text().splitlines()[1])
+        self.assertEqual(row["event"], "error")
+        self.assertEqual(row["error_type"], "RuntimeError")
+
+    def test_refuses_overwrite_and_detects_truncated_prefix(self):
+        a = self.write_trace("a")
+        with self.assertRaises(FileExistsError):
+            TracedPolicyClient(Client(), a)
+        b = self.write_trace("b")
+        b.write_text(b.read_text().splitlines()[0] + "\n")
+        result = compare_traces(a, b)
+        self.assertEqual(result["event_counts"], [1, 0])
+        self.assertFalse(result["same_recorded_trace"])
+
+    def test_distinguishes_request_action_and_signed_zero_changes(self):
+        a = self.write_trace("a")
+        payload = copy.deepcopy(self.payload)
+        payload["state"] = [0.2]
+        b = self.write_trace("b", payload, [-0.0, 1.0])
+        result = compare_traces(a, b)
+        for field in ["request_sha256", "state_sha256", "action_sha256"]:
+            self.assertEqual(result["first_different_event"][field], 0)
+        self.assertIsNone(result["first_different_event"]["image_payload_sha256"])
+        c = self.write_trace("c")
+        self.assertTrue(compare_traces(a, c)["same_recorded_trace"])
+
+    def test_rejects_tampered_values_and_partial_json(self):
+        a, b = self.write_trace("a"), self.write_trace("b")
+        lines = b.read_text().splitlines()
+        row = json.loads(lines[1])
+        row["action"][0] = 5
+        b.write_text(lines[0] + "\n" + json.dumps(row) + "\n")
+        with self.assertRaisesRegex(ValueError, "hash mismatch"):
+            compare_traces(a, b)
+        b.write_text(lines[0] + '\n{"index":')
+        with self.assertRaises(ValueError):
+            compare_traces(a, b)
+
+    def test_actual_robotwin_eval_sends_identical_execution_target(self):
+        from benchmarks.robotwin import openwam2robotwin_interface as iface
+
+        observation = {
+            "observation": {
+                k: {"rgb": np.zeros((3, 4, 3), np.uint8)} for k in ["head_camera", "left_camera", "right_camera"]
+            },
+            "endpose": {
+                "left_endpose": [0, 0, 0, 0, 0, 0, 1],
+                "right_endpose": [1, 2, 3, 0, 0, 0, 1],
+                "left_gripper": 0.25,
+                "right_gripper": 0.75,
+            },
+        }
+
+        class Env:
+            take_action_cnt = 0
+
+            def get_instruction(self):
+                return "pick"
+
+            def take_action(self, action, *, action_type):
+                self.received = (action, action_type)
+
+        def model(client):
+            m = iface.ModelClient.__new__(iface.ModelClient)
+            m._send_state, m._state_dim, m._action_indices, m._action_type = True, 20, None, "ee"
+            m._task_description, m._debug, m._step, m._client = "pick", False, 0, client
+            return m
+
+        client = Client()
+        client.response["action"] = iface._extract_eef_proprio(observation).tolist()
+        plain = Env()
+        iface.eval(plain, model(client), observation)
+        with TracedPolicyClient(client, self.path / "native") as traced:
+            observed = Env()
+            iface.eval(observed, model(traced), observation)
+        np.testing.assert_array_equal(plain.received[0], observed.received[0])
+        self.assertEqual(plain.received[1], observed.received[1])
+        self.assertEqual(len(client.calls), 2)
+
+
+if __name__ == "__main__":
+    unittest.main()
