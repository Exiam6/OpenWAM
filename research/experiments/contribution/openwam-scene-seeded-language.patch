     module.class_decorator = traced_class_decorator
 
 
+def _install_scene_seeded_language(module) -> None:
+    """Pair instruction sampling with the actual scene seed, opt-in at bootstrap.
+
+    RoboTwin seeds numpy/torch during setup but its language generator also
+    uses Python random. Restore that generator's state so this affects language
+    only, including when instruction generation fails.
+    """
+    original_class = module.class_decorator
+    original_generate = module.generate_episode_descriptions
+    scene_seed = None
+
+    def seeded_class(task_name):
+        env = original_class(task_name)
+        original_setup = env.setup_demo
+
+        def setup(*args, **kwargs):
+            nonlocal scene_seed
+            scene_seed = kwargs.get("seed")
+            return original_setup(*args, **kwargs)
+
+        env.setup_demo = setup
+        return env
+
+    def generate(*args, **kwargs):
+        if scene_seed is None:
+            raise RuntimeError("Scene-seeded language requires setup_demo(seed=...) before instruction generation")
+        state = random.getstate()
+        try:
+            random.seed(int(scene_seed))
+            return original_generate(*args, **kwargs)
+        finally:
+            random.setstate(state)
+
+    module.class_decorator = seeded_class
+    module.generate_episode_descriptions = generate
+
+
