[Unit]
Description=OpenWAM GPU5 finite resume worker
OnSuccess=openwam-gpu5-monitor.service
OnFailure=openwam-gpu5-monitor.service
[Service]
Type=simple
WorkingDirectory=/home/zifanz4/openwam-runtime/temporal-new-20260928/resume-v1
ExecStart=/usr/bin/python3 -u /home/zifanz4/openwam-runtime/temporal-new-20260928/resume-v1/run.py
KillMode=control-group
TimeoutStopSec=60
Restart=no
StandardOutput=append:/home/zifanz4/openwam-runtime/temporal-new-20260928/resume-v1/worker.log
StandardError=inherit
